# Ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Модель для итогового анализа и рекомендаций (reasoning)
REASONING_MODEL=deepseek/deepseek-r1

# Быстрая и дешёвая модель для отбора ссылок и выжимок статей
FAST_MODEL=google/gemini-2.5-flash-lite

# Автоматический анализ каждые N часов, пока запущен дашборд (0 — выключено)
AUTO_RUN_HOURS=0
